# Custom OpenLDAP schema installed by `ligoj dev init` (openldap): the AUXILIARY class and attribute
# that back the demo LDAP node's `people-custom-attributes` (uidFonctionnel) and `people-class-create`
# (mefiPersonne) parameters. Copied to the mounted schema dir as custom.ldif (bitnami applies it on a
# first boot) and added over ldapi:/// on an already-initialized volume.
dn: cn=sample,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: sample
olcAttributeTypes: {0}( 1.1.2.1.1.1 NAME 'uidFonctionnel' DESC 'Identifies an attribute 1.' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 SINGLE-VALUE )
olcObjectClasses: {0}( 1.3.6.1.4.1.42.2.27.4.2.1 NAME 'mefiPersonne' DESC 'mefiPersonne' SUP top AUXILIARY MUST ( uidFonctionnel ) )
