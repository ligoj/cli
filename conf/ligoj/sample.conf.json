    "harbor": {
        "endpoint": "https://harbor.example.com",
        "user": "admin",
        "password": "password",
        "projects": [
            {
                "name": "{{ project.name }}-public",
                "public": true,
                "roles": {
                    "dev": {
                        "role": "Developer"
                    },
                    "admin": {
                        "role": "Project Admin"
                    }
                }
            },
            {
                "name": "{{ project.name }}-internal",
                "public": false,
                "roles": {
                    "admin": {
                        "role": "Project Admin"
                    }
                }
            }
        ]
    },
    "nexus": {
        "repositories": [
            {
                "id": "mvn-picdemo1",
                "format": "maven",
                "attributes": {},
                "data": {},
                "roles": {
                    "admin": {
                        "view-permissions": [
                            "*"
                        ],
                        "admin-permissions": [
                            "*"
                        ]
                    },
                    "dev": {
                        "view-permissions": [
                            "browse",
                            "read",
                            "delete",
                            "add"
                        ],
                        "admin-permissions": [
                            "browse",
                            "read",
                            "delete"
                        ]
                    },
                    "test": {
                        "view-permissions": [
                            "browse"
                        ]
                    }
                }
            }
        ]
    },
    "sonar": {
        "templates": [
            {
                "name": "sample",
                "projectPattern": "picdemo1:*",
                "roles": {
                    "dev": {
                        "permissions": [
                            "admin"
                        ]
                    },
                    "admin": {
                        "permissions": [
                            "admin"
                        ]
                    },
                    "test": {
                        "permissions": [
                            "gateadmin",
                            "scan"
                        ]
                    }
                }
            }
        ],
        "projects": [
            {
                "name": "{{ project.name }}",
                "key": "{{ project.id }}:jar",
                "visibility": "public",
                "roles": {
                    "dev": {
                        "permissions": [
                            "codeviewer",
                            "issueadmin",
                            "securityhotspotadmin",
                            "scan",
                            "user"
                        ]
                    },
                    "admin": {
                        "permissions": [
                            "admin"
                        ]
                    },
                    "test": {
                        "permissions": [
